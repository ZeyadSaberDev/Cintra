# Server runtime
NODE_ENV=development
PORT=3000
# Local development only. Production must use the deployed public HTTPS origin.
APP_URL=http://localhost:3000

# Shared server-side SQLite database and file storage
LOCAL_DATA_DIR=./data
# Optional absolute database path; defaults to LOCAL_DATA_DIR/cintra.sqlite
# LOCAL_DB_PATH=

# Admin security. Generate both independently as random values of at least 32 characters.
ADMIN_ACCESS_KEY=
ADMIN_SESSION_SECRET=
# Optional. Signup with this email receives the initial administrator role.
ADMIN_EMAIL=

# SMTP used for email OTP sign-in. SMTP_FROM must be authorized by the provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI provider (server-side)
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=https://freellmapi-zeyad.up.railway.app/v1
FREELLMAPI_DEFAULT_MODEL=auto
FREELLMAPI_MODELS=
FREELLMAPI_TTS_MODEL=google/gemini-2.5-flash-tts
FREELLMAPI_STT_MODEL=groq/whisper-large-v3
CLEANAPIS_IMAGE_API_KEY=
CLEANAPIS_IMAGE_BASE_URL=
CLEANAPIS_IMAGE_MODEL=cf/black-forest-labs/flux-1-schnell
GOOGLE_TTS_API_KEY=

# Optional billing integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PLUS_MONTHLY=

# Development-only Vite server option
DISABLE_HMR=false
